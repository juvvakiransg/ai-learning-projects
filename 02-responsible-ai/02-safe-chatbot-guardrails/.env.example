# Optional. The application runs in mock mode without an API key.
PORT=3001
HOST=127.0.0.1
AI_PROVIDER=mock
# For optional live generation: AI_PROVIDER=openai and OPENAI_API_KEY=...
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: enable OpenAI moderation for both input and output in live mode
USE_OPENAI_MODERATION=true
